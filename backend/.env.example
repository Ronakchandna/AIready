# Copy to .env for local development. On Render these are set in the service's Environment tab.
PORT=5000
NODE_ENV=development

# Supabase Postgres - Session pooler connection string (Supabase -> Connect -> "Session pooler").
# Tables are created automatically on first start.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Long random string used to sign login tokens
JWT_SECRET=

# Allowed browser origins (comma separated), e.g. https://airesume-web.onrender.com
FRONTEND_URL=http://localhost:3000

# Python AI engine
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=

# Resume PDF uploads are stored in the database by default.
# To use Cloudinary instead set FILE_STORAGE=cloudinary and the three keys.
FILE_STORAGE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email - forgot password OTP.
# Option 1 (works on Render free, which blocks SMTP): Brevo API key (brevo.com, free 300 emails/day).
# EMAIL_FROM must be a sender address verified in Brevo.
BREVO_API_KEY=
# Option 2 (local dev): SMTP, e.g. Gmail with an App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
